# Copie para .env (que nunca é commitado) e preencha.
# Com `docker compose up --build`, só o JWT_SECRET precisa ser trocado.

# Obrigatório: texto aleatório com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# E-mail. Padrão: Mailpit do docker compose (caixa de entrada em http://localhost:8025).
# Para SMTP real, troque host, porta, usuário e senha (ex.: Mailtrap, Gmail).
# Rodando a API fora do Docker (./mvnw), use MAIL_HOST=localhost.
# A API sempre autentica no SMTP: usuário e senha não podem ficar vazios.
# O Mailpit aceita qualquer valor.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=labmanager
MAIL_PASSWORD=labmanager
MAIL_FROM=no-reply@labmanager.local

# Endereços vistos pelo navegador
APP_BASE_URL=http://localhost:8080
APP_FRONT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Primeiro ADMIN, criado pelo serviço admin-seed só se não existir nenhum
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@labmanager.local
ADMIN_PASSWORD=Admin@12345

# Só se as portas padrão já estiverem em uso. Mudou FRONT_PORT ou APP_PORT?
# Ajuste também APP_FRONT_URL, CORS_ALLOWED_ORIGINS, APP_BASE_URL e VITE_API_URL.
# DB_PORT=5432
# APP_PORT=8080
# FRONT_PORT=5173
# MAILPIT_PORT=8025

# Pasta do repositório do front, se não estiver em ../LabManagerFrontend
# FRONT_DIR=../LabManagerFrontend
