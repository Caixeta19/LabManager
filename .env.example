# Copie para .env (que nunca é commitado) e preencha.
# Com `docker compose up --build`, só o JWT_SECRET precisa ser trocado.

# Obrigatório: texto aleatório com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# E-mail. A API sempre autentica no SMTP: usuário e senha não podem ficar vazios.
#
# OPÇÃO A (padrão) — Mailpit do docker compose, nada sai para a internet.
# Caixa de entrada em http://localhost:8025. O Mailpit aceita qualquer usuário/senha.
# Rodando a API fora do Docker (./mvnw), use MAIL_HOST=localhost.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=labmanager
MAIL_PASSWORD=labmanager
MAIL_FROM=no-reply@labmanager.local
MAIL_STARTTLS_REQUIRED=false
#
# OPÇÃO B — Gmail (envio real). Comente o bloco A e descomente este.
# 1. Ative a verificação em duas etapas na conta Google.
# 2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#    (16 letras; cole sem espaços). A senha normal da conta NÃO funciona.
# 3. MAIL_FROM deve ser o próprio Gmail (o Gmail troca qualquer outro remetente).
# O .env está no .gitignore: nunca commite a senha de app.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu.email@gmail.com
# MAIL_PASSWORD=senha-de-app-de-16-letras
# MAIL_FROM=seu.email@gmail.com
# MAIL_STARTTLS_REQUIRED=true

# Endereços vistos pelo navegador
APP_BASE_URL=http://localhost:8080
APP_FRONT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Primeiro ADMIN, criado pelo serviço admin-seed só se não existir nenhum
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@labmanager.local
ADMIN_PASSWORD=Admin@12345

# Só se as portas padrão já estiverem em uso. Mudou FRONT_PORT ou APP_PORT?
# Ajuste também APP_FRONT_URL, CORS_ALLOWED_ORIGINS, APP_BASE_URL e VITE_API_URL.
# DB_PORT=5432
# APP_PORT=8080
# FRONT_PORT=5173
# MAILPIT_PORT=8025

# Pasta do repositório do front, se não estiver em ../LabManagerFrontend
# FRONT_DIR=../LabManagerFrontend
